    <record id="account_invoice_recompute_intrastat_country_wizard" model="ir.ui.view">
        <field name="name">account.invoice.recompute.intrastat.country.wizard</field>
        <field name="model">account.invoice.recompute_intrastat_country</field>
        <field name="arch" type="xml">
            <form string="Recompute Intrastat Country">
                <p class="oe_grey">
                    Recompute Origin/Destination Country and Intrastat Country.
                </p>
                <footer>
                    <button string="Recompute" name="recompute_intrastat_country" type="object" default_focus="1" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <act_window id="action_account_invoice_recompute_intrastat_country"
        multi="True"
        key2="client_action_multi"
        name="Recompute Intrastat Country"
        res_model="account.invoice.recompute_intrastat_country"
        src_model="account.invoice"
        view_mode="form" target="new"
        view_type="form"
        groups="base.group_no_one"/>
</odoo>
